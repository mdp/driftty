# @defaultSensitive=true @defaultRequired=false
# ---

# Cloudflare connector token; required by the root Compose deployment.
# @required
CLOUDFLARE_TUNNEL_TOKEN=

# Stable gateway password; omit to generate a password at startup.
DRIFTTY_PASSWORD=

# Gateway listener and optional workspace service.
# @public @type=port(min=1)
DRIFTTY_PORT=7681
# @public @type=string
DRIFTTY_HOST=0.0.0.0
# @public @type=string
DRIFTTY_ENABLE_WORKSPACES=0
# @public @type=string
DRIFTTY_WORKSPACE_API_HOST=127.0.0.1
# @public @type=string
DRIFTTY_STATE_FILE=
# @public @type=port(min=1)
DRIFTTY_TTYD_START_PORT=7800
# Override the checksum-managed ttyd binary.
# @public @type=string
DRIFTTY_TTYD_PATH=
# Optional host configuration paths.
# @public @type=string
PROFILES_FILE=
# @public @type=string
DRIFTTY_PROJECTS_FILE=
# @public @type=string
KNOWN_HOSTS_FILE=
# @public @type=string
DRIFTTY_KEYS_DIR=/keys

# Host-only workspace provisioning and shared credentials.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
GITHUB_TOKEN=

# Published image tag: latest release, edge, or a version.
# @public @type=string
DRIFTTY_TAG=latest

# Optional web-development Compose settings.
DRIFTTY_DEV_TOKEN=
# @public @type=string
DRIFTTY_DEV_HOSTNAME=
# @public @type=ip(version=4)
DRIFTTY_DEV_TAILSCALE_IP=
# @public @type=port(min=1)
DRIFTTY_DEV_PORT=7681

# Legacy workspace settings may remain in local env files. Current Compose
# does not forward them; mark credentials sensitive for safe diagnostics.
# @public @type=string
DRIFTTY_WORKSPACE_CLI=
DRIFTTY_GITHUB_TOKEN=
DRIFTTY_OPENAI_API_KEY=
DRIFTTY_ANTHROPIC_API_KEY=
DRIFTTY_OPENCODE_API_KEY=
DRIFTTY_CLINE_API_KEY=
