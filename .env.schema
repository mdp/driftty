# @defaultSensitive=true @defaultRequired=false
# ---

# Cloudflare connector token; required by the root Compose deployment.
# @required
CLOUDFLARE_TUNNEL_TOKEN=

# Stable gateway password; omit to generate a password at startup.
DRIFTTY_PASSWORD=

# Published image tag: latest release, edge, or a version.
# @public @type=string
DRIFTTY_TAG=latest

# Optional web-development Compose settings.
DRIFTTY_DEV_TOKEN=
# @public @type=string
DRIFTTY_DEV_HOSTNAME=
# @public @type=ip(version=4)
DRIFTTY_DEV_TAILSCALE_IP=
# @public @type=port(min=1)
DRIFTTY_DEV_PORT=7681

# Legacy workspace settings may remain in local env files. Current Compose
# does not forward them; mark credentials sensitive for safe diagnostics.
# @public @type=string
DRIFTTY_WORKSPACE_CLI=
DRIFTTY_GITHUB_TOKEN=
DRIFTTY_OPENAI_API_KEY=
DRIFTTY_ANTHROPIC_API_KEY=
DRIFTTY_OPENCODE_API_KEY=
DRIFTTY_CLINE_API_KEY=
