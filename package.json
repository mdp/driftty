{
  "private": true,
  "name": "driftty",
  "version": "3.0.0",
  "description": "Mobile-first tty gateway and terminal image",
  "repository": {
    "url": "https://github.com/mdp/driftty.git",
    "type": "git"
  },
  "author": "Mark Percival",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:gateway": "cd gateway && bun test",
    "test:all": "npm test && npm run test:gateway",
    "release:bundle": "bun scripts/package-release.ts",
    "env:check": "varlock load --agent",
    "env:encrypt": "varlock encrypt --file .env",
    "env:encrypt:cloudflare": "varlock encrypt --file examples/cloudflare-ssh/.env",
    "env:encrypt:development": "varlock encrypt --file examples/docker-development/.env",
    "compose": "varlock run --inject vars -- docker compose",
    "compose:cloudflare": "varlock run --path examples/cloudflare-ssh/ --inject vars -- docker compose --project-directory examples/cloudflare-ssh",
    "compose:development": "varlock run --path examples/docker-development/ --inject vars -- docker compose --project-directory examples/docker-development"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "varlock": "1.18.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "decko": "^1.2.0",
    "preact": "^10.29.7"
  }
}
