{
  "private": true,
  "name": "ttyd-mobile",
  "version": "3.0.0",
  "description": "Mobile-friendly ttyd client and optional multi-host SSH gateway",
  "repository": {
    "url": "https://github.com/mdp/ttyd-mobile.git",
    "type": "git"
  },
  "author": "Mark Percival",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:gateway": "cd gateway && bun test",
    "test:all": "npm test && npm run test:gateway",
    "release:bundle": "bun scripts/package-release.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "decko": "^1.2.0",
    "preact": "^10.29.7"
  }
}
