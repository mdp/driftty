# Image tag to deploy from ghcr.io/mdp/driftty-demo. `gwdemo` is the driftty
# gateway + coding-agent tmux session (single-password login page); `insta`
# is the plain ttyd demo; edge/latest are the published CI images.
DRIFTTY_TAG=gwdemo

# Stable master password for the driftty login page; leave empty and setup.sh
# generates one.
DRIFTTY_PASSWORD=

# Optional provider keys, injected into the container as OPENAI_API_KEY
# (OpenCode, Codex) and ANTHROPIC_API_KEY (Claude, Cline). Leave empty to skip.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: name of the InstaCloud project to create.
# DRIFTTY_INSTA_PROJECT=driftty-demo

# Optional: deploy from this directory's Dockerfile (remote source build on
# InstaCloud) instead of the prebuilt image above. Requires the insta build
# toolchain (fly CLI); leave 0 to use the prebuilt image.
# DRIFTTY_INSTA_SOURCE=0