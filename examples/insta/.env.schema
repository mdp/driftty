# @defaultSensitive=true @defaultRequired=false
# ---

# Stable master password for the driftty login page; setup.sh generates and
# prints one if left empty.
DRIFTTY_PASSWORD=

# Image tag to deploy from ghcr.io/mdp/driftty-demo (gwdemo = gateway demo).
# @public @type=string
DRIFTTY_TAG=gwdemo

# Optional provider keys, injected into the container when set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional project name override.
# @public @type=string
DRIFTTY_INSTA_PROJECT=driftty-demo

# Set to 1 to deploy this directory's Dockerfile from source instead of the
# prebuilt image.
# @public @type=string
DRIFTTY_INSTA_SOURCE=0