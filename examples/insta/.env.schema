# @defaultSensitive=true @defaultRequired=false
# ---

# Stable demo password; setup.sh generates and prints one if left empty.
DRIFTTY_DEMO_PASSWORD=

# Image tag to deploy from ghcr.io/mdp/driftty-demo (edge or latest).
# @public @type=string
DRIFTTY_TAG=edge

# Optional provider keys, injected into the container when set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional project name override.
# @public @type=string
DRIFTTY_INSTA_PROJECT=driftty-demo
