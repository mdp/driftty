# Shared host configuration. Keep actual values in this directory's ignored
# .env / .env.local files and protect sensitive entries with Varlock.
# @defaultSensitive=true @defaultRequired=false
# ---

# @sensitive
DRIFTTY_PASSWORD=
# Vercel provisioning credentials are host-only and are never forwarded.
# @sensitive
VERCEL_TOKEN=
# @public
VERCEL_TEAM_ID=
# @public
VERCEL_PROJECT_ID=
# Shared GitHub identity used for repository and PR operations.
# @sensitive
GITHUB_TOKEN=

# Optional listener settings.
# @public @type=port(min=1)
DRIFTTY_PORT=7681
# @public @type=string
DRIFTTY_HOST=0.0.0.0
