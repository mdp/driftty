# @defaultSensitive=true @defaultRequired=false
# ---

# Master password used by the gateway login page.
# @required
DRIFTTY_PASSWORD=

# Loopback browser port; zero asks Docker to allocate a free port.
# @public @type=port
DRIFTTY_PORT=7681

# Host user/group IDs for workspace files and generated keys.
# @public @type=number(isDivisibleBy=1, min=1)
DEV_UID=1000
# @public @type=number(isDivisibleBy=1, min=1)
DEV_GID=1000
